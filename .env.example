# Copy to .env and edit. NEVER commit .env. Placeholders only; real values stay on the server.

# production (default) needs HTTPS and SESSION_SECRET. Use development only on localhost.
APP_ENV=development

# Shared access code people type to unlock the demo (12+ characters in production).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(16))"
ACCESS_CODE=change-me-to-a-long-random-code

# Signs the sign-in cookie (32+ characters, required in production).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-generate-a-long-random-value

# Bearer key for external MCP clients (24+ characters). Leave empty to DISABLE the /mcp/ endpoint.
MCP_API_KEY=

# Hostnames the app answers to (comma-separated). Add your public domain when deploying.
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra trusted browser origins, only if the page is served from a different origin than the API.
ALLOWED_ORIGINS=
# Secure cookies are on in production; set false only to test production mode over plain http://localhost.
# COOKIE_SECURE=false

# --- AWS Bedrock ---
AWS_DEFAULT_REGION=ap-southeast-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Prefer an IAM role (EC2 instance profile) or an AWS profile. For local development only, you may export
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in your shell instead of writing them in this file.

# --- Limits (defaults shown) ---
# CHAT_PER_MIN=12
# GLOBAL_CHAT_PER_HOUR=300
# LOGIN_PER_MIN=5
# TURN_TIMEOUT_S=45
# COOKIE_TTL_HOURS=24

# Database location (default: data/talksous.db). In Docker this is /data/talksous.db on a volume.
# TALKSOUS_DB=data/talksous.db
